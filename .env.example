# --- Jeeves / NVIDIA (Mem0) configuration ---
# Copy this file to `.env` and fill in your NVIDIA API key.
# NVIDIA's API is OpenAI-compatible, so Mem0 talks to it via the OpenAI provider
# with a custom base_url.
#
# LOCAL DEV: set NVIDIA_API_KEY + JEEVES_TZ, leave JEEVES_DB_URL blank (uses local SQLite).
# RENDER/PROD: set JEEVES_DB_URL (Supabase Postgres) + SUPABASE_URL/KEY; the app
# auto-selects Supabase and ignores the local SQLite path.

# Your NVIDIA API key (https://build.nvidia.com/)
NVIDIA_API_KEY=sk-...

# OpenAI-compatible base URL for NVIDIA's hosted models
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Chat model used for fact extraction (Mem0) and answering questions.
# VALIDATED for this account (the 70B asset is gated; 120B Super works).
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Faster model for per-message structured extraction (~1.1s on this account;
# quality is fine for fact extraction, keeps capture snappy).
NVIDIA_EXTRACT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Embedding model (used by Mem0). nemotron-3-embed-1b needs no extra params.
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# --- App config ---
# LOCAL/DEV: SQLite file (used when JEEVES_DB_URL is empty).
JEEVES_DB_PATH=./jeeves.db

# PROD (Render + Supabase): a full Postgres URL. When set, it wins over JEEVES_DB_PATH
# and the app uses SQLAlchemy against Supabase (same code path as local SQLite).
# Example (Supabase pooler): postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
JEEVES_DB_URL=

# Supabase project credentials (used by Mem0's pgvector store in prod).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Host/port for the web UI
JEEVES_HOST=127.0.0.1
JEEVES_PORT=8000

# Time zone the owner lives in (IANA name). Drives "today"/date-aware answers.
JEEVES_TZ=Asia/Kolkata
